# Public (safe for the browser bundle) — from Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push — add these to each Vercel environment where push should work
# (Preview and Production are separate scopes). Generate a matching key pair
# with `npx web-push generate-vapid-keys`; keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Server-only — shared with push_config.notify_secret in Supabase.
# The database uses this to call the deployed /api/push/notify route.
PUSH_NOTIFY_SECRET=

# Server-only — NEVER prefix with NEXT_PUBLIC_. Used only inside
# app/admin/actions.ts to create employee accounts via the Admin API.
SUPABASE_SERVICE_ROLE_KEY=

# The static front-desk QR code's payload (Phase 1). Replace the
# validation logic in components/employee/PunchInFlow.tsx when you
# move to a rotating/signed QR on a dedicated screen.
NEXT_PUBLIC_DESK_QR_VALUE=QUREOCITY-FRONT-DESK

# Only needed if you use the fallback Vercel Cron route (app/api/cron)
# instead of pg_cron. Vercel automatically sends this as a Bearer token
# to your cron routes when this env var is present — generate any
# random string.
CRON_SECRET=

QR_SIGNING_SECRET=
